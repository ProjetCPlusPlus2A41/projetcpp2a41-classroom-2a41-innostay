   <property name="styleSheet">
    <string notr="true">#widget{
background-color: #3e8299;
}
#pushButton, #pushButton_1,#pushButton_2,#pushButton_3,#pushButton_4,#pushButton_6{
background-color: transparent ;
background: rgba(255, 255, 255, 0.5); 
 backdrop-filter: blur(10px); 
 -webkit-backdrop-filter: blur(10px);
border-radius:20px ;
}
#pushButton_5{
background-color: transparent;
border: 2px solid rgba(255, 255, 255, 0.5);
border-radius: 20px;
backdrop-filter: blur(10px);
-webkit-backdrop-filter: blur(10px);
}
#widget_2{
background-color: transparent;
background: rgba(255, 255, 255, 0.5);
backdrop-filter: blur(10px);
-webkit-backdrop-filter: blur(10px);
border-radius: 20px;
border: 2px solid rgba(255, 255, 255, 0.5);
}
#lineEdit_16,#lineEdit_17,#lineEdit_18,#lineEdit_19,#lineEdit_20{background-color: transparent;
background: rgba(176, 176, 176, 0.8); /* Couleur gris clair moyen */
backdrop-filter: blur(10px);
-webkit-backdrop-filter: blur(10px);
border-radius: 30px; /* Coins arrondis */
border: 2px solid rgba(255, 255, 255, 0.5);

}
#pushButton_7, #pushButton_8, #pushButton_9, #pushButton_10, 
#pushButton_11, #pushButton_12, #pushButton_13, #pushButton_14 {
    background-color: rgba(255, 255, 255, 0.3);  /* Arrière-plan transparent avec effet de flou simulé */
    color: black;                                /* Texte en noir */
    border: none;                                /* Pas de bordure */
    border-radius: 5px;                          /* Coins arrondis pour un effet esthétique */
}

#pushButton_7:hover, #pushButton_8:hover, #pushButton_9:hover, #pushButton_10:hover, 
#pushButton_11:hover, #pushButton_12:hover, #pushButton_13:hover, #pushButton_14:hover {
    background-color: rgba(255, 255, 255, 0.5);  /* Arrière-plan légèrement plus visible lors du survol */
}
#pushButton_15 {
    background-color: transparent;
    color: #70a2a8;
    font-size: 10pt;
    font-weight: bold;
    text-decoration: underline;
    border: none;
}

</string>
