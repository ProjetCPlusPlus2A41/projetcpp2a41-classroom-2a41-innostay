    <property name="styleSheet">
     <string notr="true">
QTableWidget {
    background-color: #e0f2ff;  /* Couleur de fond bleu clair */
    alternate-background-color: #b3e5fc;  /* Couleur d'arrière-plan pour lignes alternées */
    gridline-color: #81d4fa;  /* Couleur des lignes de grille */
    border: 1px solid #0288d1;  /* Bordure de la table */
    font-size: 14px;
    color: #01579b;  /* Couleur du texte */
}
/* Style des onglets */
QTabBar::tab {
    background: #0277bd;  /* Couleur de fond pour les onglets non sélectionnés */
    color: white;
    padding: 8px 16px;
    margin-right: 2px;  /* Espacement entre les onglets */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #0288d1;  /* Bordure pour les onglets non sélectionnés */
}

QTabBar::tab:hover {
    background: #0288d1;  /* Couleur de fond pour les onglets au survol */
}

QTabBar::tab:selected {
    background: #01579b;  /* Couleur de fond pour l'onglet sélectionné */
    font-weight: bold;
    color: #ffffff;
    border: 1px solid #01579b;
}

QTabBar::tab:!selected {
    background: #0277bd;  /* Fond pour les onglets non sélectionnés */
    color: #ffffff;
}

/* Style de l'onglet lorsqu'il est dans un état désactivé */
QTabBar::tab:disabled {
    color: #b0bec5;  /* Couleur gris clair pour les onglets désactivés */
}

/* Ajustement des boutons de défilement pour les onglets trop nombreux */
QTabBar::scroller {
    background-color: #0277bd;
}

QTabBar QToolButton {
    background-color: #0277bd;  /* Boutons de défilement dans la barre d'onglets */
    border: none;
    color: white;
}

QTabBar QToolButton:hover {
    background-color: #0288d1;
}

QTabBar QToolButton:pressed {
    background-color: #01579b;
}</string>
