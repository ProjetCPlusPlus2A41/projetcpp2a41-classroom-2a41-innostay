       <property name="styleSheet">
        <string notr="true">#pushButton_2 {
    background-color: transparent;
    border: 2px solid rgba(255, 255, 255, 0.5);  /* Bordure transparente similaire à la transparence utilisée */
    
    /* Forme elliptique avec des dimensions réduites */
    width: 100px;
    height: 50px;
    
    /* Bordure arrondie pour un effet elliptique */
    border-radius: 25px;
}</string>
       </property>
       <property name="text">
        <string>gestion des employés</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_4">
       <property name="styleSheet">
        <string notr="true">#pushButton_4 {
    font: 75 8pt &quot;MS Shell Dlg 2&quot;;
    font-weight: bold;  /* Forcer le texte à être en gras */
    background-color: transparent;
    background: rgba(255, 255, 255, 0.5); 
    backdrop-filter: blur(10px); 
    -webkit-backdrop-filter: blur(10px);
    
    /* Forme elliptique */
    width: 150px;
    height: 70px;
    
    /* Bordure arrondie complète pour un effet ovale */
    border-radius: 35px; /* La moitié de la hauteur pour arrondir */
    
    border: none; /* Supprimer les bordures */
}</string>
       </property>
       <property name="text">
        <string>gestion des réservations</string>
       </property>
      </widget>
     </item>
